{
	frankenphp
	auto_https off
	admin off
}

:80 {
	root * /app/public
	encode zstd gzip

	# WebSockets of phones, screen and moderator -> Reverb container
	handle /app/* {
		reverse_proxy reverb:8080
	}

	# Hashed build assets and uploaded images can be cached for long
	@immutable path /build/assets/* /storage/games/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	handle {
		php_server
	}
}
