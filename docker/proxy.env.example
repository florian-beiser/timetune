# Operation behind an HTTPS reverse proxy (e.g. Caddy):
#   cp docker/proxy.env.example docker/proxy.env   # adjust values
#   docker compose --env-file docker/proxy.env up -d --build

# Public address (used for links generated outside a request, e.g. in jobs)
TIMETUNE_APP_URL=https://timetune.beiser.info

# Proxies whose X-Forwarded-* headers are trusted. "private" = all private
# networks (Caddy on the same host or in Docker). For a proxy on another
# server, enter its IP, e.g. 203.0.113.10. Never use "*" if port 8090 is
# reachable from the internet.
TIMETUNE_TRUSTED_PROXIES=private

# Cookies only over HTTPS
TIMETUNE_SECURE_COOKIES=true

# Port on the host the proxy forwards to; 127.0.0.1 = only reachable locally
# (Caddy runs directly on this host). Use 0.0.0.0 if Caddy runs in another
# container or on another machine.
TIMETUNE_PORT=8090
TIMETUNE_BIND=127.0.0.1
